---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="right">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<div class="resume-wrap">
					<HeaderLink href="/resume">Resume</HeaderLink>
					<div class="resume-pop" aria-hidden="true">
						<img src="/resume-preview.png" alt="" width="850" height="1100" decoding="async" />
					</div>
				</div>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://www.linkedin.com/in/hamzaasad26/" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Hamza on LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
						<path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/hamzaasad26" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Hamza on GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1rem;
		background: transparent;
		box-shadow: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 880px;
		margin: 0 auto;
		padding: 1.25rem 0;
		font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
		font-size: 13px;
	}
	h2 {
		margin: 0;
		font-size: 13px;
		font-weight: 700;
		font-family: inherit;
	}
	h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}
	.internal-links :global(a) {
		padding: 0;
		border-bottom: none;
		color: rgb(var(--gray));
		text-decoration: none;
		font-weight: 400;
		transition: color 0.2s ease;
	}
	.internal-links :global(a:hover) {
		color: rgb(var(--black));
	}
	.internal-links :global(a.active) {
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
		border-bottom: none;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social-links a {
		display: flex;
		color: rgb(var(--gray));
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: rgb(var(--black));
	}

	/* Resume hover preview: rises from the bottom edge, flush with the screen */
	.resume-wrap {
		display: flex;
		align-items: center;
	}
	.resume-pop {
		position: fixed;
		bottom: 0;
		left: 50%;
		width: min(840px, 94vw);
		height: 72vh;
		overflow: hidden;
		background: #fff;
		border: 1px solid color-mix(in srgb, rgb(var(--gray)) 40%, transparent);
		border-bottom: none;
		border-radius: 10px 10px 0 0;
		box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.18);
		z-index: 50;
		visibility: hidden;
		pointer-events: none;
		transform: translate(-50%, 100%);
		transition:
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0.3s;
	}
	.resume-wrap:hover .resume-pop,
	.resume-wrap:focus-within .resume-pop {
		visibility: visible;
		transform: translate(-50%, 0);
	}
	.resume-pop img {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (max-width: 720px), (hover: none) {
		.resume-pop {
			display: none;
		}
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		nav {
			padding: 1rem 0;
		}
		h2 {
			white-space: nowrap;
		}
		.right {
			gap: 0.9rem;
		}
		.internal-links {
			gap: 0.8rem;
			white-space: nowrap;
		}
		.social-links {
			display: none;
		}
	}
	@media (max-width: 400px) {
		nav {
			font-size: 12px;
		}
		h2 {
			font-size: 12px;
		}
	}
</style>