---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
const { inCol = false } = Astro.props;
---

<section class:list={['feedback', { 'in-col': inCol }]} aria-labelledby="feedback-title">
	<div class="intro">
		<h2 id="feedback-title">$ tail -f feedback.log</h2>
		<p>
			Tell me what worked and what didn't on this site. Every note you leave becomes a line in
			the log.
		</p>
	</div>

	<div class="panel">
		<div class="titlebar">
			<div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
			<div class="filename">feedback.log</div>
			<div class="status-pill"><span class="live" aria-hidden="true"></span>training</div>
		</div>

		<div class="stats">
			<div>epochs <strong id="fb-count">0</strong></div>
		</div>

		<div class="logwrap">
			<div
				class="cell static"
				id="fb-cell"
				tabindex="0"
				role="region"
				aria-label="Feedback log, scrollable"
			>
				<ol class="log" id="fb-log">
					<li class="row">
						<span class="epoch">epoch 01</span>
						<span class="sep" aria-hidden="true">|</span>
						<span class="msg muted">loading the log...</span>
					</li>
				</ol>
				<!-- Copies 2 and 3 only exist to make the endless loop seamless. -->
				<ol class="log" id="fb-log2" aria-hidden="true" hidden></ol>
				<ol class="log" id="fb-log3" aria-hidden="true" hidden></ol>
			</div>
			<svg class="hint up" id="fb-hint-up" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
			<svg class="hint down" id="fb-hint-down" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</div>

		<form class="next" id="fb-form" autocomplete="off">
			<div class="row input-row">
				<span class="epoch next-epoch">epoch <span id="fb-next">01</span></span>
				<span class="sep" aria-hidden="true">|</span>
				<div class="note">
					<span class="muted note-label">reader:</span>
					<textarea
						name="message"
						rows="2"
						maxlength="280"
						required
						aria-label="Your feedback note"
						placeholder="type your note here..."></textarea>
				</div>
			</div>

			<!-- Bot trap: humans never see or fill this. -->
			<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="controls">
				<input
					type="text"
					name="name"
					maxlength="30"
					aria-label="Your name (optional)"
					placeholder="name (optional)"
				/>
				<button type="submit" id="fb-submit">run epoch ↵</button>
			</div>
			<p class="status" id="fb-status" role="status" aria-live="polite"></p>
		</form>
	</div>

	<p class="fine">No account needed. Notes show up in the log right away.</p>

	<!-- Row blueprint used by the script, so dynamic rows get the same styles. -->
	<template id="fb-row">
		<li class="row">
			<span class="epoch"></span>
			<span class="sep" aria-hidden="true">|</span>
			<span class="msg"><span class="muted who"></span> <span class="text"></span></span>
		</li>
	</template>
</section>

<script>
	import { db } from '../lib/firebase';
	import {
		addDoc,
		collection,
		limitToLast,
		onSnapshot,
		orderBy,
		query,
		serverTimestamp,
	} from 'firebase/firestore';

	const pad = (n: number) => String(n).padStart(2, '0');

	const cell = document.getElementById('fb-cell') as HTMLElement;
	const copies = [
		document.getElementById('fb-log'),
		document.getElementById('fb-log2'),
		document.getElementById('fb-log3'),
	] as HTMLOListElement[];
	const hintUp = document.getElementById('fb-hint-up') as unknown as SVGElement;
	const hintDown = document.getElementById('fb-hint-down') as unknown as SVGElement;
	const count = document.getElementById('fb-count') as HTMLElement;
	const next = document.getElementById('fb-next') as HTMLElement;
	const form = document.getElementById('fb-form') as HTMLFormElement;
	const submit = document.getElementById('fb-submit') as HTMLButtonElement;
	const status = document.getElementById('fb-status') as HTMLElement;
	const tpl = document.getElementById('fb-row') as HTMLTemplateElement;

	/* ---------- auto-scroll settings (tweak these) ---------- */
	const AUTO = 20; // px per second when nobody is hovering
	const MAX = 170; // px per second at the very edge of the cell
	const ZONE = 0.38; // top/bottom share of the cell that triggers scrolling

	/* ---------- scroll state ---------- */
	let pos = 0;
	let last = 0;
	let lastH = 0;
	let looping = false;
	let inside = false;
	let my = 0;
	let touching = false;
	let focused = false;
	let onScreen = true;
	let pendingJump = false;
	let touchTimer: number | undefined;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const interacting = () => inside || touching || focused;

	cell.addEventListener('pointerenter', (e) => {
		if (e.pointerType === 'mouse') inside = true;
	});
	cell.addEventListener('pointermove', (e) => {
		if (e.pointerType !== 'mouse') return;
		inside = true;
		my = e.clientY - cell.getBoundingClientRect().top;
	});
	cell.addEventListener('pointerleave', (e) => {
		if (e.pointerType === 'mouse') inside = false;
	});
	cell.addEventListener(
		'touchstart',
		() => {
			touching = true;
			window.clearTimeout(touchTimer);
		},
		{ passive: true },
	);
	cell.addEventListener('touchend', () => {
		window.clearTimeout(touchTimer);
		touchTimer = window.setTimeout(() => (touching = false), 1800);
	});
	cell.addEventListener('focusin', () => (focused = true));
	cell.addEventListener('focusout', () => (focused = false));
	// Wheel, keyboard and touch scrolling: adopt wherever the user moved to.
	cell.addEventListener('scroll', () => {
		if (Math.abs(cell.scrollTop - pos) > 2) pos = cell.scrollTop;
	});

	if ('IntersectionObserver' in window) {
		new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting)).observe(cell);
	}

	function setHints(up: boolean, down: boolean) {
		hintUp.classList.toggle('on', up);
		hintDown.classList.toggle('on', down);
	}

	function frame(t: number) {
		const dt = last ? Math.min((t - last) / 1000, 0.05) : 0;
		last = t;

		const h = copies[0].offsetHeight;
		const vh = cell.clientHeight;
		const shouldLoop = h > vh + 2;

		if (shouldLoop !== looping) {
			// Enough notes to fill the cell: switch the loop on (or off again).
			looping = shouldLoop;
			cell.classList.toggle('static', !looping);
			copies[1].hidden = copies[2].hidden = !looping;
			pos = looping ? h : 0;
			lastH = h;
			cell.scrollTop = pos;
		} else if (looping && h !== lastH) {
			// Content height changed (new note, font loaded): keep the same spot in view.
			pos = h + (pos - lastH);
			lastH = h;
		}

		if (pendingJump) {
			pendingJump = false;
			if (looping) {
				pos = 2 * h - vh;
				lastH = h;
				cell.scrollTop = pos;
			}
		}

		if (looping && onScreen) {
			let v = 0;
			if (touching || focused) {
				v = 0;
			} else if (inside) {
				const z = vh * ZONE;
				if (my < z) v = -(1 - my / z) * MAX;
				else if (my > vh - z) v = ((my - (vh - z)) / z) * MAX;
			} else {
				v = reduced ? 0 : AUTO;
			}
			setHints(inside && v < 0, inside && v > 0);

			pos += v * dt;
			if (pos >= 2 * h) pos -= h;
			else if (pos < h) pos += h;
			if (Math.abs(cell.scrollTop - pos) > 0.5) cell.scrollTop = pos;
		} else {
			setHints(false, false);
		}

		requestAnimationFrame(frame);
	}
	requestAnimationFrame(frame);

	/* ---------- rows ---------- */
	function makeRow(epoch: number) {
		const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
		li.querySelector('.epoch')!.textContent = 'epoch ' + pad(epoch);
		return li;
	}

	function renderRows(rows: HTMLElement[]) {
		copies[0].replaceChildren(...rows);
		copies[1].replaceChildren(...rows.map((r) => r.cloneNode(true)));
		copies[2].replaceChildren(...rows.map((r) => r.cloneNode(true)));
	}

	function showMessageRow(text: string, epoch = 1) {
		const li = makeRow(epoch);
		const msg = li.querySelector('.msg')!;
		msg.textContent = text;
		msg.classList.add('muted');
		renderRows([li]);
	}

	// Live feed: every new note appears here without a reload.
	const seen = new Set<string>();
	let initialised = false;
	const q = query(collection(db, 'feedback'), orderBy('createdAt', 'asc'), limitToLast(50));
	onSnapshot(
		q,
		(snap) => {
			count.textContent = String(snap.size);
			next.textContent = pad(snap.size + 1);
			if (snap.empty) {
				seen.clear();
				initialised = true;
				showMessageRow('waiting for the first note...');
				return;
			}
			let hasNew = false;
			const rows = snap.docs.map((d, i) => {
				const data = d.data();
				const li = makeRow(i + 1);
				const name = typeof data.name === 'string' ? data.name.trim() : '';
				// textContent only, so visitors can never inject HTML.
				li.querySelector('.who')!.textContent = name ? `reader (${name}):` : 'reader:';
				li.querySelector('.text')!.textContent = `“${String(data.message ?? '')}”`;
				if (initialised && !seen.has(d.id)) {
					li.classList.add('new');
					hasNew = true;
				}
				seen.add(d.id);
				return li;
			});
			initialised = true;
			renderRows(rows);
			// Like tail -f: jump to the newest line, unless someone is reading the log.
			if (hasNew && !interacting()) pendingJump = true;
		},
		() => showMessageRow("can't reach the log right now, try again later."),
	);

	/* ---------- form ---------- */
	function setStatus(text: string) {
		status.textContent = text;
	}

	const COOLDOWN_MS = 60_000;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const fd = new FormData(form);

		// Bot trap filled in: pretend it worked, store nothing.
		if (fd.get('website')) {
			form.reset();
			setStatus('> note received. thanks!');
			return;
		}

		const message = String(fd.get('message') ?? '').trim();
		const name = String(fd.get('name') ?? '').trim().slice(0, 30);
		if (!message) {
			setStatus('> write something first.');
			return;
		}

		let lastPost = 0;
		try {
			lastPost = Number(localStorage.getItem('fb_last') ?? 0);
		} catch {}
		if (Date.now() - lastPost < COOLDOWN_MS) {
			setStatus('> easy there, give it a minute before the next note.');
			return;
		}

		submit.disabled = true;
		try {
			await addDoc(collection(db, 'feedback'), {
				message,
				name,
				createdAt: serverTimestamp(),
			});
			try {
				localStorage.setItem('fb_last', String(Date.now()));
			} catch {}
			form.reset();
			setStatus('> note received. thanks!');
		} catch {
			setStatus('> something went wrong, try again in a bit.');
		} finally {
			submit.disabled = false;
		}
	});
</script>

<style>
	.feedback {
		--accent: #3ddc84;
		--panel: #0f1115;
		--panel-raised: #161a21;
		--panel-form: #12151b;
		--line: #1f242c;
		--text: #e6e9ef;
		--muted: #7d8594;
		width: 100%;
		max-width: 770px;
		margin: 4rem auto 0;
		padding: 0 30px 2.5rem;
		box-sizing: border-box;
		font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
		color: rgb(var(--gray-dark));
		text-align: left;
	}
	.intro h2 {
		margin: 0 0 12px;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: rgb(var(--black));
	}
	.intro p {
		margin: 0 0 28px;
		font-size: 15px;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		max-width: 560px;
	}

	.panel {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 0;
		overflow: hidden;
	}
	:global(:root[data-theme='dark']) .panel {
		border-color: #2f3644;
	}
	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: var(--panel-raised);
		border-bottom: 1px solid var(--line);
		font-size: 12px;
		color: #9aa3b2;
	}
	.dots {
		display: flex;
		gap: 8px;
	}
	.dots span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #3a404b;
	}
	.filename {
		font-size: 13px;
	}
	.status-pill {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.live {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.stats {
		display: flex;
		gap: 28px;
		padding: 14px 20px;
		border-bottom: 1px solid var(--line);
		font-size: 13px;
		color: #9aa3b2;
	}
	.stats strong {
		color: var(--text);
		font-weight: 700;
	}

	/* Fixed-size log: never grows, scrolls inside itself */
	.logwrap {
		position: relative;
	}
	.cell {
		height: 200px;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: none;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
	}
	.cell::-webkit-scrollbar {
		display: none;
	}
	.cell.static {
		overflow: hidden;
		-webkit-mask-image: none;
		mask-image: none;
	}
	.cell:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.hint {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		color: #9aa3b2;
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}
	.hint.on {
		opacity: 0.9;
	}
	.hint.up {
		top: 4px;
	}
	.hint.down {
		bottom: 4px;
	}

	.log {
		list-style: none;
		margin: 0;
		padding: 8px 0 12px;
	}
	.row {
		display: flex;
		gap: 12px;
		align-items: baseline;
		padding: 9px 20px;
		font-size: 14px;
		line-height: 1.5;
	}
	.row.new {
		animation:
			fb-in 0.7s ease-out both,
			fb-hl 2.4s ease-out both;
	}
	@keyframes fb-in {
		from {
			opacity: 0;
			transform: translateY(8px);
			filter: blur(3px);
		}
		to {
			opacity: 1;
			transform: none;
			filter: none;
		}
	}
	@keyframes fb-hl {
		0% {
			background: rgba(61, 220, 132, 0.14);
		}
		100% {
			background: transparent;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.row.new {
			animation: none;
		}
	}
	.epoch {
		flex: 0 0 76px;
		color: var(--muted);
	}
	.sep {
		flex: 0 0 auto;
		color: #3a404b;
	}
	.msg {
		flex: 1 1 0;
		min-width: 0;
		color: var(--text);
		overflow-wrap: anywhere;
	}
	.muted {
		color: var(--muted);
	}

	.next {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 20px 20px 12px;
		background: var(--panel-form);
		border-top: 1px solid var(--line);
	}
	.next .row {
		padding: 0;
		align-items: flex-start;
	}
	.next-epoch,
	.next .sep,
	.note-label {
		padding-top: 10px;
	}
	.note {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}
	.note-label {
		flex: 0 0 auto;
	}
	textarea,
	input {
		box-sizing: border-box;
		background: var(--panel);
		color: var(--text);
		border: 1px solid #2a303a;
		border-radius: 0;
		padding: 10px 12px;
		font-family: inherit;
		line-height: 1.5;
	}
	textarea {
		flex: 1 1 0;
		min-width: 0;
		width: auto;
		font-size: 14px;
		resize: vertical;
	}
	input {
		width: 170px;
		font-size: 13px;
	}
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	textarea::placeholder,
	input::placeholder {
		color: var(--muted);
		opacity: 1;
	}
	textarea:focus-visible,
	input:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.controls {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-left: 88px;
	}
	button {
		min-height: 44px;
		padding: 11px 18px;
		background: var(--accent);
		color: #06210f;
		border: 0;
		border-radius: 0;
		font-family: inherit;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
	}
	button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
	.status {
		margin: 0;
		margin-top: -16px; /* cancels the flex gap while the status is empty */
		min-height: 0;
		padding-left: 88px;
		font-size: 13px;
		line-height: 1.5;
		color: var(--accent);
	}
	/* Space comes back only when a message is showing */
	.status:not(:empty) {
		margin-top: 0;
		min-height: 1.5em;
	}

	.fine {
		margin: 12px 0 0;
		font-size: 12px;
		line-height: 1.6;
		color: rgb(var(--gray));
	}

	@media (max-width: 640px) {
		.cell {
			height: 200px;
		}
		.row {
			flex-wrap: wrap;
			row-gap: 2px;
		}
		.sep {
			display: none;
		}
		.msg {
			flex-basis: 100%;
		}
		.input-row .note {
			flex-basis: 100%;
		}
		.next .sep,
		.next-epoch {
			padding-top: 0;
		}
		.controls,
		.status {
			padding-left: 0;
		}
		.controls input {
			flex: 1 1 140px;
			width: auto;
		}
	}

	/* match column.css: page gutters at 1000px and 720px */
	@media (max-width: 1000px) {
		.feedback {
			width: calc(100% - 28px);
		}
	}
	@media (max-width: 720px) {
		.feedback {
			width: calc(100% - 24px);
			padding: 0 16px 2.5rem;
		}
	}
	/* when placed inside the home .col: inherit its width, gutters and side lines */
.feedback.in-col {
	width: 100%;
	max-width: none;
	margin: 0;
	padding: 48px var(--pad) 2.5rem;
}
</style>