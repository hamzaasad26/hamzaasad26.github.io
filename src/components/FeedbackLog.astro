---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
---

<section class="feedback" aria-labelledby="feedback-title">
	<div class="intro">
		<h2 id="feedback-title">$ tail -f feedback.log</h2>
		<p>
			Tell me what worked and what didn't on this site. Every note you leave becomes a line in
			the log.
		</p>
	</div>

	<div class="panel">
		<div class="titlebar">
			<div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
			<div class="filename">feedback.log</div>
			<div class="status-pill"><span class="live" aria-hidden="true"></span>training</div>
		</div>

		<div class="stats">
			<div>epochs <strong id="fb-count">0</strong></div>
		</div>

		<ol class="log" id="fb-log">
			<li class="row">
				<span class="epoch">epoch 01</span>
				<span class="sep" aria-hidden="true">|</span>
				<span class="msg muted">loading the log...</span>
			</li>
		</ol>

		<form class="next" id="fb-form" autocomplete="off">
			<div class="row input-row">
				<span class="epoch next-epoch">epoch <span id="fb-next">01</span></span>
				<span class="sep" aria-hidden="true">|</span>
				<div class="note">
					<span class="muted note-label">reader:</span>
					<textarea
						name="message"
						rows="3"
						maxlength="280"
						required
						aria-label="Your feedback note"
						placeholder="type your note here..."></textarea>
				</div>
			</div>

			<!-- Bot trap: humans never see or fill this. -->
			<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="controls">
				<input
					type="text"
					name="name"
					maxlength="30"
					aria-label="Your name (optional)"
					placeholder="name (optional)"
				/>
				<button type="submit" id="fb-submit">run epoch ↵</button>
			</div>
			<p class="status" id="fb-status" role="status" aria-live="polite"></p>
		</form>
	</div>

	<p class="fine">No account needed. Notes show up in the log right away.</p>

	<!-- Row blueprint used by the script, so dynamic rows get the same styles. -->
	<template id="fb-row">
		<li class="row">
			<span class="epoch"></span>
			<span class="sep" aria-hidden="true">|</span>
			<span class="msg"><span class="muted who"></span> <span class="text"></span></span>
		</li>
	</template>
</section>

<script>
	import { db } from '../lib/firebase';
	import {
		addDoc,
		collection,
		limitToLast,
		onSnapshot,
		orderBy,
		query,
		serverTimestamp,
	} from 'firebase/firestore';

	const pad = (n: number) => String(n).padStart(2, '0');

	const log = document.getElementById('fb-log') as HTMLOListElement;
	const count = document.getElementById('fb-count') as HTMLElement;
	const next = document.getElementById('fb-next') as HTMLElement;
	const form = document.getElementById('fb-form') as HTMLFormElement;
	const submit = document.getElementById('fb-submit') as HTMLButtonElement;
	const status = document.getElementById('fb-status') as HTMLElement;
	const tpl = document.getElementById('fb-row') as HTMLTemplateElement;

	function makeRow(epoch: number) {
		const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
		li.querySelector('.epoch')!.textContent = 'epoch ' + pad(epoch);
		return li;
	}

	function showMessageRow(text: string, epoch = 1) {
		const li = makeRow(epoch);
		const msg = li.querySelector('.msg')!;
		msg.textContent = text;
		msg.classList.add('muted');
		log.replaceChildren(li);
	}

	// Live feed: every new note appears here without a reload.
	const q = query(collection(db, 'feedback'), orderBy('createdAt', 'asc'), limitToLast(50));
	onSnapshot(
		q,
		(snap) => {
			count.textContent = String(snap.size);
			next.textContent = pad(snap.size + 1);
			if (snap.empty) {
				showMessageRow('waiting for the first note...');
				return;
			}
			const rows = snap.docs.map((d, i) => {
				const data = d.data();
				const li = makeRow(i + 1);
				const name = typeof data.name === 'string' ? data.name.trim() : '';
				// textContent only, so visitors can never inject HTML.
				li.querySelector('.who')!.textContent = name ? `reader (${name}):` : 'reader:';
				li.querySelector('.text')!.textContent = `“${String(data.message ?? '')}”`;
				return li;
			});
			log.replaceChildren(...rows);
		},
		() => showMessageRow("can't reach the log right now, try again later."),
	);

	function setStatus(text: string) {
		status.textContent = text;
	}

	const COOLDOWN_MS = 60_000;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const fd = new FormData(form);

		// Bot trap filled in: pretend it worked, store nothing.
		if (fd.get('website')) {
			form.reset();
			setStatus('> note received. thanks!');
			return;
		}

		const message = String(fd.get('message') ?? '').trim();
		const name = String(fd.get('name') ?? '').trim().slice(0, 30);
		if (!message) {
			setStatus('> write something first.');
			return;
		}

		let last = 0;
		try {
			last = Number(localStorage.getItem('fb_last') ?? 0);
		} catch {}
		if (Date.now() - last < COOLDOWN_MS) {
			setStatus('> easy there, give it a minute before the next note.');
			return;
		}

		submit.disabled = true;
		try {
			await addDoc(collection(db, 'feedback'), {
				message,
				name,
				createdAt: serverTimestamp(),
			});
			try {
				localStorage.setItem('fb_last', String(Date.now()));
			} catch {}
			form.reset();
			setStatus('> note received. thanks!');
		} catch {
			setStatus('> something went wrong, try again in a bit.');
		} finally {
			submit.disabled = false;
		}
	});
</script>

<style>
	.feedback {
		--accent: #3ddc84;
		--panel: #0f1115;
		--panel-raised: #161a21;
		--panel-form: #12151b;
		--line: #1f242c;
		--text: #e6e9ef;
		--muted: #7d8594;
		max-width: 720px;
		margin: 4rem auto 0;
		padding: 0 1em;
		box-sizing: border-box;
		font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
		color: #14161a;
		text-align: left;
	}
	.intro h2 {
		margin: 0 0 12px;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: #14161a;
	}
	.intro p {
		margin: 0 0 28px;
		font-size: 15px;
		line-height: 1.6;
		color: #4b5563;
		max-width: 560px;
	}

	.panel {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
	}
	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: var(--panel-raised);
		border-bottom: 1px solid var(--line);
		font-size: 12px;
		color: #9aa3b2;
	}
	.dots {
		display: flex;
		gap: 8px;
	}
	.dots span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #3a404b;
	}
	.filename {
		font-size: 13px;
	}
	.status-pill {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.live {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.stats {
		display: flex;
		gap: 28px;
		padding: 14px 20px;
		border-bottom: 1px solid var(--line);
		font-size: 13px;
		color: #9aa3b2;
	}
	.stats strong {
		color: var(--text);
		font-weight: 700;
	}

	.log {
		list-style: none;
		margin: 0;
		padding: 8px 0;
	}
	.row {
		display: flex;
		gap: 12px;
		align-items: baseline;
		padding: 9px 20px;
		font-size: 14px;
		line-height: 1.5;
	}
	.epoch {
		flex: 0 0 76px;
		color: var(--muted);
	}
	.sep {
		flex: 0 0 auto;
		color: #3a404b;
	}
	.msg {
		flex: 1 1 0;
		min-width: 0;
		color: var(--text);
		overflow-wrap: anywhere;
	}
	.muted {
		color: var(--muted);
	}

	.next {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 20px;
		background: var(--panel-form);
		border-top: 1px solid var(--line);
	}
	.next .row {
		padding: 0;
		align-items: flex-start;
	}
	.next-epoch,
	.next .sep,
	.note-label {
		padding-top: 10px;
	}
	.note {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}
	.note-label {
		flex: 0 0 auto;
	}
	textarea,
	input {
		box-sizing: border-box;
		background: var(--panel);
		color: var(--text);
		border: 1px solid #2a303a;
		border-radius: 8px;
		padding: 10px 12px;
		font-family: inherit;
		line-height: 1.5;
	}
	textarea {
		flex: 1 1 0;
		min-width: 0;
		width: auto;
		font-size: 14px;
		resize: vertical;
	}
	input {
		width: 170px;
		font-size: 13px;
	}
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	textarea::placeholder,
	input::placeholder {
		color: var(--muted);
		opacity: 1;
	}
	textarea:focus-visible,
	input:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.controls {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-left: 88px;
	}
	button {
		min-height: 44px;
		padding: 11px 18px;
		background: var(--accent);
		color: #06210f;
		border: 0;
		border-radius: 8px;
		font-family: inherit;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
	}
	button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
	.status {
		margin: 0;
		min-height: 1.5em;
		padding-left: 88px;
		font-size: 13px;
		line-height: 1.5;
		color: var(--accent);
	}

	.fine {
		margin: 12px 0 0;
		font-size: 12px;
		line-height: 1.6;
		color: #6b7280;
	}

	@media (max-width: 640px) {
		.row {
			flex-wrap: wrap;
			row-gap: 2px;
		}
		.sep {
			display: none;
		}
		.msg {
			flex-basis: 100%;
		}
		.input-row .note {
			flex-basis: 100%;
		}
		.next .sep,
		.next-epoch {
			padding-top: 0;
		}
		.controls,
		.status {
			padding-left: 0;
		}
		.controls input {
			flex: 1 1 140px;
			width: auto;
		}
	}
</style>