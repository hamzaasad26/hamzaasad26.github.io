---

import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';

// TODO (backend step): put the form endpoint URL here.
// While this is empty, the submit button stays disabled.
const formAction = '';

type Entry = { epoch: number; msg: string };

// Sample lines so you can see the design. They only appear in `npm run dev`,
// never in the production build.
const samples: Entry[] = [
	{ epoch: 5, msg: 'loved the intro' },
	{ epoch: 6, msg: 'the second half lost me, too many terms' },
	{ epoch: 7, msg: 'finally understood what a pipeline is' },
	{ epoch: 8, msg: 'code blocks are hard to read on my phone' },
	{ epoch: 9, msg: 'more real examples please' },
];

// TODO (backend step): replace with the approved notes from the database.
const entries: Entry[] = import.meta.env.DEV ? samples : [];

const nextEpoch = (entries.at(-1)?.epoch ?? 0) + 1;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="feedback" aria-labelledby="feedback-title">
	<div class="intro">
		<h2 id="feedback-title">$ tail -f feedback.log</h2>
		<p>
			Tell me what worked and what didn't on this site. Every note you leave becomes a line in
			the log.
		</p>
	</div>

	<div class="panel">
		<div class="titlebar">
			<div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
			<div class="filename">feedback.log</div>
			<div class="status"><span class="live" aria-hidden="true"></span>training</div>
		</div>

		<div class="stats">
			<div>epochs <strong>{entries.length}</strong></div>
		</div>

		<ol class="log">
			{
				entries.length === 0 ? (
					<li class="row">
						<span class="epoch">epoch 01</span>
						<span class="sep" aria-hidden="true">|</span>
						<span class="msg muted">waiting for the first note...</span>
					</li>
				) : (
					entries.map((e) => (
						<li class="row">
							<span class="epoch">epoch {pad(e.epoch)}</span>
							<span class="sep" aria-hidden="true">|</span>
							<span class="msg">
								<span class="muted">reader:</span> “{e.msg}”
							</span>
						</li>
					))
				)
			}
		</ol>

		<form class="next" method="post" action={formAction || undefined}>
			<div class="row input-row">
				<span class="epoch next-epoch">epoch {pad(nextEpoch)}</span>
				<span class="sep" aria-hidden="true">|</span>
				<div class="note">
					<span class="muted note-label">reader:</span>
					<textarea
						name="message"
						rows="3"
						required
						aria-label="Your feedback note"
						placeholder="type your note here..."></textarea>
				</div>
			</div>
			<div class="controls">
				<input
					type="text"
					name="name"
					aria-label="Your name (optional)"
					placeholder="name (optional)"
					autocomplete="name"
				/>
				<button type="submit" disabled={!formAction}>run epoch ↵</button>
			</div>
		</form>
	</div>

	<p class="fine">No account needed. Notes show up in the log after I've read them.</p>
</section>

<style>
	.feedback {
		--accent: #3ddc84;
		--panel: #0f1115;
		--panel-raised: #161a21;
		--panel-form: #12151b;
		--line: #1f242c;
		--text: #e6e9ef;
		--muted: #7d8594;
		max-width: 720px;
		margin: 4rem auto 0;
		padding: 0 1em;
		box-sizing: border-box;
		font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
		color: #14161a;
		text-align: left;
	}
	.intro h2 {
		margin: 0 0 12px;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: #14161a;
	}
	.intro p {
		margin: 0 0 28px;
		font-size: 15px;
		line-height: 1.6;
		color: #4b5563;
		max-width: 560px;
	}

	.panel {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
	}
	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: var(--panel-raised);
		border-bottom: 1px solid var(--line);
		font-size: 12px;
		color: #9aa3b2;
	}
	.dots {
		display: flex;
		gap: 8px;
	}
	.dots span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #3a404b;
	}
	.filename {
		font-size: 13px;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.live {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.stats {
		display: flex;
		gap: 28px;
		padding: 14px 20px;
		border-bottom: 1px solid var(--line);
		font-size: 13px;
		color: #9aa3b2;
	}
	.stats strong {
		color: var(--text);
		font-weight: 700;
	}

	.log {
		list-style: none;
		margin: 0;
		padding: 8px 0;
	}
	.row {
		display: flex;
		gap: 12px;
		align-items: baseline;
		padding: 9px 20px;
		font-size: 14px;
		line-height: 1.5;
	}
	.epoch {
		flex: 0 0 76px;
		color: var(--muted);
	}
	.sep {
		flex: 0 0 auto;
		color: #3a404b;
	}
	.msg {
		flex: 1 1 0;
		min-width: 0;
		color: var(--text);
		overflow-wrap: anywhere;
	}
	.muted {
		color: var(--muted);
	}

	.next {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 20px;
		background: var(--panel-form);
		border-top: 1px solid var(--line);
	}
	.next .row {
		padding: 0;
		align-items: flex-start;
	}
	.next-epoch,
	.next .sep,
	.note-label {
		padding-top: 10px;
	}
	.note {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}
	.note-label {
		flex: 0 0 auto;
	}
	textarea,
	input {
		box-sizing: border-box;
		background: var(--panel);
		color: var(--text);
		border: 1px solid #2a303a;
		border-radius: 8px;
		padding: 10px 12px;
		font-family: inherit;
		line-height: 1.5;
	}
	textarea {
		flex: 1 1 0;
		min-width: 0;
		width: auto;
		font-size: 14px;
		resize: vertical;
	}
	input {
		width: 170px;
		font-size: 13px;
	}
	textarea::placeholder,
	input::placeholder {
		color: var(--muted);
		opacity: 1;
	}
	textarea:focus-visible,
	input:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.controls {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-left: 88px;
	}
	button {
		min-height: 44px;
		padding: 11px 18px;
		background: var(--accent);
		color: #06210f;
		border: 0;
		border-radius: 8px;
		font-family: inherit;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
	}
	button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.fine {
		margin: 12px 0 0;
		font-size: 12px;
		line-height: 1.6;
		color: #6b7280;
	}

	@media (max-width: 640px) {
		.row {
			flex-wrap: wrap;
			row-gap: 2px;
		}
		.sep {
			display: none;
		}
		.msg {
			flex-basis: 100%;
		}
		.input-row .note {
			flex-basis: 100%;
		}
		.next .sep,
		.next-epoch {
			padding-top: 0;
		}
		.controls {
			padding-left: 0;
		}
		.controls input {
			flex: 1 1 140px;
			width: auto;
		}
	}
</style>