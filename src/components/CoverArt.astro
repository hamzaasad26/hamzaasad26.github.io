---
import { art, type ArtKind } from '../lib/coverArt';

interface Props {
	title: string;
	kind: ArtKind;
	ink: string;
	size?: number;
}

const { title, kind, ink, size = 36 } = Astro.props;
const { p1, p2, p3, line, lineColor } = art(title, kind, ink);
---

<svg
	class="cover-art"
	viewBox="0 0 400 240"
	preserveAspectRatio="xMidYMid slice"
	width={size}
	height={size}
	aria-hidden="true"
>
	<path d={p1} fill={ink} fill-opacity=".28"></path>
	<path d={p2} fill={ink} fill-opacity=".55"></path>
	<path d={p3} fill={ink}></path>
	{line && <path d={line} fill="none" stroke={lineColor} stroke-width="3" stroke-linecap="round"></path>}
</svg>

<style>
	.cover-art {
		flex: none;
		border-radius: 8px;
		background: #0f1115;
	}
	:global(:root[data-theme='dark']) .cover-art {
		box-shadow: 0 0 0 1px rgb(var(--gray-light));
	}
</style>