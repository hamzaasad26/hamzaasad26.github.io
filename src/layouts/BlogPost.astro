---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			/* ---------- page ---------- */
			main.post {
				--hl: rgba(var(--gray), 0.09);
				--pad: 30px;
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0 0 40px;
			}
			:root[data-theme='dark'] main.post {
				--hl: rgba(var(--gray), 0.17);
			}

			/* ---------- column + faint vertical lines (inner pair, outer gutter pair) ---------- */
			.post .col {
				position: relative;
				width: 100%;
				max-width: 680px;
				margin: 0 auto;
			}
			.post .col::before,
			.post .col::after {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				border-left: 1px solid var(--hl);
				border-right: 1px solid var(--hl);
				pointer-events: none;
			}
			.post .col::before {
				left: 0;
				right: 0;
			}
			.post .col::after {
				left: -20px;
				right: -20px;
			}

			/* ---------- hero + title ---------- */
			.post .hero-image {
				padding: 20px var(--pad) 0;
			}
			.post .hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 8px;
			}
			.post .title {
				position: relative;
				padding: 28px var(--pad) 20px;
				text-align: left;
			}
			.post .title::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 50%;
				width: 100vw;
				margin-left: -50vw;
				height: 1px;
				background: var(--hl);
			}
			.post .date {
				margin: 0 0 8px;
				font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
				font-size: 11.5px;
				line-height: 1.5;
				color: rgb(var(--gray));
			}
			.post .last-updated-on {
				margin-top: 2px;
				font-style: normal;
			}
			.post .title h1 {
				margin: 0;
				font-size: clamp(24px, 18px + 1.2vw, 32px);
				line-height: 1.15;
				letter-spacing: -0.02em;
				color: rgb(var(--black));
			}

			/* ---------- body text (!important on size/line-height so theme.css can't override) ---------- */
			.post .prose {
				padding: 18px var(--pad) 40px;
				color: rgb(var(--gray-dark));
				font-size: 14px !important;
				line-height: 25px !important;
			}
			.post .prose p,
			.post .prose li,
			.post .prose td,
			.post .prose th,
			.post .prose blockquote {
				font-size: 14px !important;
				line-height: 25px !important;
			}
			.post .prose p {
				margin: 0 0 20px;
			}
			.post .prose ul,
			.post .prose ol {
				margin: 0 0 20px;
				padding-left: 24px;
			}
			.post .prose li {
				margin-bottom: 6px;
			}
			.post .prose li > ul,
			.post .prose li > ol {
				margin: 6px 0 0;
			}
			.post .prose ol li::marker {
				color: rgb(var(--gray));
			}

			/* ---------- section headings: hairline above and below ---------- */
			.post .prose h2 {
				position: relative;
				margin: 36px 0 14px;
				padding: 8px 0;
				font-size: clamp(20px, 16px + 0.8vw, 26px) !important;
				font-weight: 500;
				line-height: 1.1 !important;
				letter-spacing: -0.02em;
				color: rgb(var(--black));
			}
			.post .prose h2 { padding: 3px 0; }
			.post .prose h2::before,
			.post .prose h2::after {
				content: '';
				position: absolute;
				left: 50%;
				width: 100vw;
				margin-left: -50vw;
				height: 1px;
				background: var(--hl);
			}
			.post .prose h2::before {
				top: 0;
			}
			.post .prose h2::after {
				bottom: 0;
			}
			.post .prose > h2:first-child {
				margin-top: 0;
			}
			.post .prose > h2:first-child::before {
				display: none;
			}

			/* sub-headings: just space, no lines */
			.post .prose h3 {
				margin: 26px 0 8px;
				font-size: 17px !important;
				font-weight: 500;
				line-height: 1.3 !important;
				letter-spacing: -0.01em;
				color: rgb(var(--black));
			}
			.post .prose h4 {
				margin: 20px 0 6px;
				font-size: 16px !important;
				line-height: 1.4 !important;
				color: rgb(var(--black));
			}

			/* ---------- code, quotes, images, tables ---------- */
			.post .prose :not(pre) > code {
				padding: 2px 5px;
				border-radius: 4px;
				background: rgba(var(--gray), 0.12);
				font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
				font-size: 0.88em !important;
			}
			.post .prose pre {
				margin: 0 0 20px;
				padding: 12px 14px;
				border-radius: 8px;
				font-size: 12.5px !important;
				line-height: 1.5 !important;
				overflow-x: auto;
			}
			.post .prose pre code {
				padding: 0;
				background: none;
				font-size: inherit !important;
			}
			.post .prose blockquote {
				margin: 0 0 20px;
				padding-left: 16px;
				border-left: 2px solid rgba(var(--gray), 0.35);
				color: rgb(var(--gray));
			}
			.post .prose img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
			}
			.post .prose hr {
				margin: 24px 0;
				border: 0;
				border-top: 1px solid var(--hl);
			}
			.post .prose table {
				display: block;
				max-width: 100%;
				overflow-x: auto;
			}

			/* ---------- narrower screens ---------- */
			@media (max-width: 780px) {
				.post .col::after {
					display: none;
				}
			}
			@media (max-width: 720px) {
				main.post {
					--pad: 20px;
				}
				.post .col::before {
					display: none;
				}
				.post .title {
					padding-top: 20px;
				}
				.post .prose {
					padding-top: 16px;
				}
				.post .prose p,
				.post .prose li,
				.post .prose blockquote {
					line-height: 26px !important;
				}
				.post .prose p {
					margin-bottom: 18px;
				}
				.post .prose h2 {
					margin: 28px 0 12px;
					font-size: 24px !important;
				}
			}
		
			
.post .hero-image img {
	width: auto;
	max-width: 100%;
	max-height: 380px;
	margin: 0 auto;
	border-radius: 0;
}
.post .prose img { border-radius: 0; }
.post .prose pre, .post .prose :not(pre) > code { border-radius: 0; }		
			
			
			
			
			/* tweak:start */
body, button, input, textarea { font-family: Inter, -apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
.post { --pad: 30px; }
@media (min-width: 721px) {
	.post .col { max-width: 770px !important; }
	.post .prose, .post .prose p, .post .prose li, .post .prose td, .post .prose th, .post .prose blockquote {
		font-size: 14px !important;
		line-height: 22.4px !important;
		font-weight: 500;
		letter-spacing: -0.031em;
	}
	.post .title h1 {
		font-size: 30px; line-height: 36px;
		font-weight: 500; letter-spacing: -0.035em;
	}
	.post .prose h2 {
		margin: 48px 0 12px;
		font-size: 24px !important; line-height: 1.2 !important;
		font-weight: 500; letter-spacing: -0.035em;
	}
	.post .prose h3 { font-weight: 500; letter-spacing: -0.025em; }
	.post .prose pre, .post .prose code { letter-spacing: 0; font-weight: 400; }
}

.post .prose table {
	display: block;
	width: max-content;
	max-width: 100%;
	overflow-x: auto;
	margin: 0 0 20px;
	border-collapse: collapse;
}
.post .prose th,
.post .prose td {
	padding: 8px 14px;
	border: 1px solid rgba(var(--gray), 0.3);
	text-align: left;
	white-space: nowrap;
}
.post .prose th {
	font-weight: 600;
	background: rgba(var(--gray), 0.08);
}



/* tweak:end */


			</style>
	</head>

	<body>
		<Header />
		<main class="post">
			<article class="col">
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} src={heroImage} alt="" />
					</div>
				)}
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)}
					</div>
					<h1>{title}</h1>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>