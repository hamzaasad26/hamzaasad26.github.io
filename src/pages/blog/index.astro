---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CoverArt from '../../components/CoverArt.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { pickArt } from '../../lib/coverArt';
import '../../styles/column.css';

const readMins = (body?: string) =>
	Math.max(1, Math.ceil((body ?? '').split(/\s+/).filter(Boolean).length / 200));

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => {
		const fallback = pickArt(post.data.title);
		return {
			post,
			kind: post.data.artKind ?? fallback.kind,
			ink: post.data.artInk ?? fallback.ink,
			mins: readMins(post.body),
		};
	});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.list {
				--ink: #27272a;
				--accent-link: #c2410c;
				display: flex;
				flex-direction: column;
			}
			:global(:root[data-theme='dark']) .list {
				--ink: rgb(var(--gray-dark));
				--accent-link: #f59e6b;
			}

			.row {
				display: grid;
				grid-template-columns: 56px minmax(0, 1fr) auto;
				grid-template-areas: 'badge body meta';
				column-gap: 16px;
				align-items: start;
				padding: 14px var(--pad);
				border-bottom: 1px solid var(--hl);
				text-decoration: none;
			}

			/* sharp, wider-than-tall thumbnail: art is drawn square and cropped to 56x36 */
			.badge {
				grid-area: badge;
				display: grid;
				place-items: center;
				width: 56px;
				height: 36px;
				overflow: hidden;
				border-radius: 0;
				margin-top: 1px;
			}
			.badge :global(*) {
				border-radius: 0 !important;
			}
			.badge :global(svg),
			.badge :global(canvas),
			.badge :global(img) {
				display: block;
				flex: none;
			}

			.body {
				grid-area: body;
				display: flex;
				flex-direction: column;
				gap: 2px;
				min-width: 0;
			}
			.title {
				margin: 0;
				font-family: 'Inter', 'Inter Variable', -apple-system, system-ui, sans-serif;
				font-size: 14px;
				line-height: 22px;
				font-weight: 500;
				letter-spacing: -0.031em;
				color: var(--ink);
				transition: color 0.2s ease;
			}
			.excerpt {
				margin: 0;
				font-size: 14px;
				line-height: 20px;
				font-weight: 500;
				letter-spacing: -0.031em;
				color: rgb(var(--gray));
			}
			.mono {
				font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
				font-size: 11.5px;
				color: rgb(var(--gray));
			}
			.meta {
				grid-area: meta;
				padding-top: 4px;
				white-space: nowrap;
			}
			.tags {
				margin-top: 4px;
				opacity: 0.8;
			}
			.row:hover .title,
			.row:focus-visible .title {
				color: var(--accent-link);
			}

			/* description + tags: hidden until you hover the row (always shown on touch screens) */
			.more {
				display: grid;
				grid-template-rows: 1fr;
				transition: grid-template-rows 0.28s ease;
			}
			.more-inner {
				display: block;
				overflow: hidden;
				min-height: 0;
			}
			@media (hover: hover) {
				.more {
					grid-template-rows: 0fr;
				}
				.row:hover .more,
				.row:focus-visible .more {
					grid-template-rows: 1fr;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.more {
					transition: none;
				}
			}

			@media (max-width: 720px) {
				.row {
					grid-template-columns: 48px minmax(0, 1fr);
					grid-template-areas:
						'badge meta'
						'badge body';
					column-gap: 12px;
					row-gap: 4px;
				}
				.badge {
					width: 48px;
					height: 32px;
					grid-row: 1 / span 2;
				}
				.meta {
					padding-top: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="page">
			<div class="col">
				<div class="band">
					<h1>Blog</h1>
				</div>
				<div class="list">
					{posts.map(({ post, kind, ink, mins }) => (
						<a class="row" href={`/blog/${post.id}/`}>
							<span class="badge">
								<CoverArt title={post.data.title} kind={kind} ink={ink} size={56} />
							</span>
							<span class="meta mono">
								<FormattedDate date={post.data.pubDate} /> · {mins} min read
							</span>
							<span class="body">
								<h2 class="title">{post.data.title}</h2>
								<span class="more">
									<span class="more-inner">
										<p class="excerpt">{post.data.description}</p>
										{post.data.tags.length > 0 && (
											<span class="tags mono">{post.data.tags.join(' · ')}</span>
										)}
									</span>
								</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>