---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CoverArt from '../../components/CoverArt.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { pickArt } from '../../lib/coverArt';

const readMins = (body?: string) =>
	Math.max(1, Math.ceil((body ?? '').split(/\s+/).filter(Boolean).length / 200));

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => {
		const fallback = pickArt(post.data.title);
		return {
			post,
			kind: post.data.artKind ?? fallback.kind,
			ink: post.data.artInk ?? fallback.ink,
			mins: readMins(post.body),
		};
	});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 880px;
				margin: 0 auto;
				padding: 2rem 1rem 4rem;
			}
			h1 {
				font-size: clamp(2.125rem, 1.6rem + 1.2vw, 2.5rem);
				letter-spacing: -0.02em;
				line-height: 1.2;
				margin: 0 0 1.5rem;
				color: rgb(var(--black));
			}
			.list {
				display: flex;
				flex-direction: column;
			}
			.row {
				display: grid;
				grid-template-columns: 32px minmax(0, 1fr) auto;
				grid-template-areas: 'badge body meta';
				column-gap: 14px;
				align-items: start;
				padding: 16px 0;
				border-top: 1px solid color-mix(in srgb, rgb(var(--gray)) 40%, transparent);
				text-decoration: none;
			}
			.row:last-child {
				border-bottom: 1px solid color-mix(in srgb, rgb(var(--gray)) 40%, transparent);
			}
			.badge {
				grid-area: badge;
				display: flex;
			}
			.body {
				grid-area: body;
				display: flex;
				flex-direction: column;
				gap: 4px;
				min-width: 0;
			}
			.meta {
				grid-area: meta;
				padding-top: 2px;
				white-space: nowrap;
			}
			.mono {
				font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
				font-size: 12px;
				color: rgb(var(--gray));
			}
			.title {
				margin: 0;
				font-size: 1.0625rem;
				line-height: 1.3;
				font-weight: 700;
				letter-spacing: -0.01em;
				color: rgb(var(--black));
				transition: color 0.2s ease;
			}
			.excerpt {
				margin: 0;
				font-size: 14px;
				line-height: 1.5;
				color: color-mix(in srgb, rgb(var(--gray-dark)) 80%, transparent);
			}
			.tags {
				margin-top: 2px;
			}
			.row:hover .title {
				color: rgb(var(--accent));
			}
			@media (max-width: 600px) {
				.row {
					grid-template-columns: 32px minmax(0, 1fr);
					grid-template-areas:
						'badge meta'
						'badge body';
					row-gap: 4px;
				}
				.meta {
					padding-top: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<div class="list">
				{posts.map(({ post, kind, ink, mins }) => (
					<a class="row" href={`/blog/${post.id}/`}>
						<span class="badge">
							<CoverArt title={post.data.title} kind={kind} ink={ink} size={32} />
						</span>
						<span class="meta mono">
							<FormattedDate date={post.data.pubDate} /> · {mins} min read
						</span>
						<span class="body">
							<h2 class="title">{post.data.title}</h2>
							<p class="excerpt">{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<span class="tags mono">{post.data.tags.join(' · ')}</span>
							)}
						</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>