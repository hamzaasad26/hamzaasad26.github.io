---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhotoWall from '../components/PhotoWall.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/column.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page">
			<div class="col">
				<div class="band">
					<h1>Hi, I'm Hamza</h1>
				</div>

				<div class="text">
					<p>
						I've done my Undergrad in Data Science at FAST NUCES, Islamabad. I love data and numbers,
						but what really hooks me is what they can tell us about what happens next. Predicting
						outcomes from patterns is what pulled me into AI/ML, and it's what I keep coming back to.
					</p>
					<p>
						I read and write as much as I can. This site is where I share what I'm learning:
						project write-ups, notes from things I'm building, and the occasional deep dive.
					</p>
					<p>
						Start with the <a href="/blog">blog</a>, or find me on
						<a href="https://github.com/hamzaasad26">GitHub</a> and
						<a href="https://www.linkedin.com/in/hamzaasad26/">LinkedIn</a>.
					</p>
				</div>

				<PhotoWall />
			</div>
		</main>
		<Footer />
	</body>
</html>